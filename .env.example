# Copy to .env and fill in. Never commit .env.
# Local Postgres 17 runs on port 5433 (port 5432 is used by another Postgres on this Mac).
DATABASE_URL=postgresql://localhost:5433/gitguru
APP_TOKEN=
CORS_ORIGINS=http://localhost:3000
LLM_CHAIN=groq,gemini,ollama
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_MODEL=qwen2.5-coder:3b
EMBED_MODEL=jinaai/jina-embeddings-v2-base-code
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
GITHUB_TOKEN=
